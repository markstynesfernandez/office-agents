# Station server configuration for the LIVE checkout (..\office-agents-live). The owner copies this to
# ..\office-agents-live\.env by hand (never committed) and fills in the two keys. The server reads that file only.
# Nothing here is ever sent to the browser, and every secret value is redacted from the logs.
# scripts/start-live.ps1 sets STATION_INSTANCE, STATION_PORT and STATION_DATA_ROOT itself; the lines below are the same
# values, for an npm start without the script.

# Which Station this is (L1): live. It runs only from the live worktree, on branch live, with no uncommitted changes to
# tracked files, and logs the commit it runs.
STATION_INSTANCE=live

# Model provider: live (Anthropic text and web, OpenRouter images; caps and prices in config/engine.json).
STATION_PROVIDER=live

# Port for the live Station (8790 only).
STATION_PORT=8790

# Data root: default ./data (this checkout's data\, the station's real data). Must stay inside this checkout.
# STATION_DATA_ROOT=data

# The legacy build (StarNet era), read-only.
# STATION_LEGACY_ROOT=C:\Users\marks\projects\Virtual-workers

# API keys (live provider only). Fill in by hand.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Etsy Open API (E7a: the own-shop connection, read only; no Etsy data reaches the scout). Fill in by hand.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# The key the Etsy tokens are encrypted with at rest (data\etsy\token.enc.json): at least 32 random characters, made once
# and kept. Changing it makes the stored token unreadable (disconnect and connect again).
ETSY_TOKEN_KEY=
# Optional: the redirect URI registered in your Etsy app, if it is not https://localhost/station/etsy-callback.
# ETSY_REDIRECT_URI=
