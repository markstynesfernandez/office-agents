# Station server configuration. Copy to .env (never committed). The server reads this file only.
# Nothing here is ever sent to the browser, and every secret value is redacted from the logs.

# Port for the Station server (default 8790; 8787 is the legacy system's and is refused).
STATION_PORT=8790

# Where the engine keeps everything it writes (jobs, ledger, events, the database). Default: office-agents/data.
# Must not be inside the legacy build; the engine refuses to start if it is.
# STATION_DATA_ROOT=C:\Users\marks\projects\office-agents\data

# The legacy build (StarNet era), read-only: the legacy view, the fixtures snapshot, port-drift and (E4) the importer.
# Nothing is ever written there.
# STATION_LEGACY_ROOT=C:\Users\marks\projects\Virtual-workers

# Model provider: mock (scripted replies, $0, no keys; E1-E5) or live (E6, after the owner's go-ahead).
STATION_PROVIDER=mock

# API keys, live provider only (E6). Leave unset while STATION_PROVIDER=mock: the mock never reads them.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
