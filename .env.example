# Station server configuration for the DEV checkout (office-agents/). Copy to .env (never committed). The server reads
# this file only. Nothing here is ever sent to the browser, and every secret value is redacted from the logs.
# The live Station has its own checkout and its own .env: see .env.live.example and README "Running live".

# Which Station this is (L1): dev here. Unset also means dev. The dev instance refuses STATION_PROVIDER=live, port 8790
# and any data root in the live checkout.
STATION_INSTANCE=dev

# Port for the dev Station (8791; 8790 is the live instance's and is refused here; 8787 is the legacy system's).
STATION_PORT=8791

# Where the engine keeps everything it writes (jobs, ledger, events, the database). Default ./data (this checkout's
# scratch data). Must not be inside the legacy build or the live checkout; the engine refuses to start if it is.
# STATION_DATA_ROOT=data

# The legacy build (StarNet era), read-only: the legacy view, the fixtures snapshot, port-drift and (E4) the importer.
# Nothing is ever written there.
# STATION_LEGACY_ROOT=C:\Users\marks\projects\Virtual-workers

# Model provider: mock only on dev (scripted replies, $0, no keys read). Live runs only on the live instance.
STATION_PROVIDER=mock

# No API keys are needed on dev: the mock never reads them. Leave them out of the dev .env.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
